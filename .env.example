# Supabase PostgreSQL.
# Runtime URL: use the Supavisor session pooler (port 5432) for a long-running
# NestJS server, or the direct URL if the runtime host has IPv6 access.
DATABASE_URL="postgresql://postgres.yrxgzcbgmhvbqjoyvtvm:[YOUR-PASSWORD]@aws-1-ca-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Schema-changing CLI connections should use the direct URL or session pooler.
# Never use the transaction pooler (port 6543) for migrations.
MIGRATION_DATABASE_URL="postgresql://postgres.yrxgzcbgmhvbqjoyvtvm:[YOUR-PASSWORD]@aws-1-ca-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Optional PEM CA path. TLS verification remains enabled with or without a CA.
# DATABASE_SSL_CA_PATH="certs/supabase-ca.pem"

# Supabase Auth
SUPABASE_URL="https://<PROJECT_REF>.supabase.co"
SUPABASE_ANON_KEY="<SUPABASE_ANON_KEY>"
SUPABASE_SERVICE_ROLE_KEY="<SUPABASE_SERVICE_ROLE_KEY>"
# Optional: matching Supabase account is granted the admin role on login.
INITIAL_ADMIN_EMAIL="admin@example.com"

# JWT
JWT_SECRET="<RANDOM_SECRET_AT_LEAST_32_CHARACTERS>"
JWT_EXPIRES_IN="1d"

# App
PORT=3000
NODE_ENV=development
